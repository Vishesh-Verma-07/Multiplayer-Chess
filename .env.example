# Root environment for docker-compose / local tooling.
# Copy to .env and adjust. Never commit the real .env.

# Shared JWT secret (must match across https-backend and backend)
AUTH_JWT_SECRET=dev-only-secret-change-me

# CORS origin allowed by the HTTP API
FRONTEND_ORIGIN=http://localhost:3000

# Build-time URLs baked into the frontend bundle
VITE_HTTPS_BACKEND_URL=http://localhost:8000
VITE_WEBSOCKET_BACKEND_URL=ws://localhost:8080/api/ws