# Copy to .env.local. NEXT_PUBLIC_* values are inlined into the browser bundle at build time.

# Express API (auth + games). Must allow this app's origin via FRONTEND_ORIGIN on the API.
NEXT_PUBLIC_HTTPS_BACKEND_URL=http://localhost:8000

# WebSocket game server (the /api/ws path is required; spectators use /api/ws/spectate).
NEXT_PUBLIC_WEBSOCKET_BACKEND_URL=ws://localhost:8080/api/ws
